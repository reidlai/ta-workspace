    "@tailwindcss/vite": "^4.1.18",
    "autoprefixer": "^10.4.23",
    "bits-ui": "^1.8.0",
    "jsdom": "^25.0.0",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "8.6.17",
    "svelte": "^5.0.0",
